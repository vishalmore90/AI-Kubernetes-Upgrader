    "namespaces": [
      {
        "metadata": {
          "name": "default"
        }
      },
      {
        "metadata": {
          "name": "kube-system"
        }
      },
      {
        "metadata": {
          "name": "cert-manager"
        }
      },
      {
        "metadata": {
          "name": "ingress-nginx"
        }
      },
      {
        "metadata": {
          "name": "monitoring"
        }
      },
      {
        "metadata": {
          "name": "payments-prod"
        }
      }
    ]
  },
  "workloads": {
    "deployments": [
      {
        "apiVersion": "apps/v1",
        "kind": "Deployment",
        "metadata": {
          "name": "cert-manager-controller",
          "namespace": "cert-manager"
        },
        "spec": {
          "template": {
            "spec": {
              "containers": [
                {
                  "image": "quay.io/jetstack/cert-manager-controller:v1.8.0"
                }
              ]
            }
          }
        }
      },
      {
        "apiVersion": "apps/v1",
        "kind": "Deployment",
        "metadata": {
          "name": "ingress-nginx-controller",
          "namespace": "ingress-nginx"
        },
        "spec": {
          "template": {
            "spec": {
              "containers": [
                {
                  "image": "registry.k8s.io/ingress-nginx/controller:v1.1.2"
                }
              ]
            }
          }
        }
      },
      {
        "apiVersion": "apps/v1",
        "kind": "Deployment",
        "metadata": {
          "name": "cluster-autoscaler",
          "namespace": "kube-system"
        },
        "spec": {
          "template": {
            "spec": {
              "containers": [
                {
                  "image": "registry.k8s.io/autoscaling/cluster-autoscaler:v1.25.0"
                }
              ]
            }
          }
        }
      },
      {
        "apiVersion": "apps/v1",
        "kind": "Deployment",
        "metadata": {
          "name": "payment-api",
          "namespace": "payments-prod"
        },
        "spec": {
          "template": {
            "spec": {
              "containers": [
                {
                  "image": "internal.registry/payment-api:v2.4.1"
                }
              ]
            }
          }
        }
      }
    ],
    "statefulsets": [],
    "daemonsets": [
      {
        "apiVersion": "apps/v1",
        "kind": "DaemonSet",
        "metadata": {
          "name": "aws-node",
          "namespace": "kube-system"
        },
        "spec": {
          "template": {
            "spec": {
              "containers": [
                {
                  "image": "602401143452.dkr.ecr.us-east-1.amazonaws.com/amazon-k8s-cni:v1.12.0"
                }
              ]
            }
          }
        }
      }
    ],
    "jobs": [],
    "cronjobs": [
      {
        "apiVersion": "batch/v1beta1",
        "kind": "CronJob",
        "metadata": {
          "name": "nightly-reconciliation",
          "namespace": "payments-prod"
        },
        "spec": {
          "schedule": "0 2 * * *"
        }
      }
    ],
    "pods": [
      {
        "apiVersion": "policy/v1beta1",
        "kind": "PodDisruptionBudget",
        "metadata": {
          "name": "payment-api-pdb",
          "namespace": "payments-prod"
        },
        "spec": {
          "minAvailable": 2
        }
      },
      {
        "apiVersion": "autoscaling/v2beta2",
        "kind": "HorizontalPodAutoscaler",
        "metadata": {
          "name": "payment-api-hpa",
          "namespace": "payments-prod"
        },
        "spec": {
          "minReplicas": 2,
          "maxReplicas": 10
        }
      }
    ]
  },
  "crds": [
    {
      "apiVersion": "apiextensions.k8s.io/v1",
      "kind": "CustomResourceDefinition",
      "metadata": {
        "name": "certificates.cert-manager.io"
      },
      "spec": {
        "group": "cert-manager.io",
        "names": {
          "kind": "Certificate"
        },
        "versions": [
          {
            "name": "v1",
            "served": true,
            "storage": true
          }
        ],
        "conversion": {
          "strategy": "None"
        }
      }
    },
    {
      "apiVersion": "apiextensions.k8s.io/v1beta1",
      "kind": "CustomResourceDefinition",
      "metadata": {
        "name": "prometheuses.monitoring.coreos.com"
      },
      "spec": {
        "group": "monitoring.coreos.com",
        "names": {
          "kind": "Prometheus"
        },
        "versions": [
          {
            "name": "v1",
            "served": true,
            "storage": true
          }
        ],
        "conversion": {
          "strategy": "None"
        }
      }
    }
  ],
  "webhooks": {
    "validating": [
      {
        "metadata": {
          "name": "cert-manager-webhook"
        },
        "webhooks": [
          {
            "failurePolicy": "Fail",
            "sideEffects": "None",
            "rules": [
              {
                "apiGroups": [
                  "cert-manager.io"
                ],
                "apiVersions": [
                  "v1"
                ],
                "operations": [
                  "CREATE",
                  "UPDATE"
                ],
                "resources": [
                  "*"
                ]
              }
            ]
          }
        ]
      }
    ],
    "mutating": []
  },
  "storage": {
    "storage_classes": [
      {
        "metadata": {
          "name": "gp2-legacy"
        },
        "provisioner": "kubernetes.io/aws-ebs",
        "reclaimPolicy": "Delete"
      },
      {
        "metadata": {
          "name": "gp3-csi"
        },
        "provisioner": "ebs.csi.aws.com",
        "reclaimPolicy": "Delete"
      }
    ],
    "pvs": [],
    "pvcs": []
  }
}