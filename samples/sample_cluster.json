        "status": {
          "nodeInfo": {
            "kubeletVersion": "v1.25.0",
            "osImage": "Ubuntu 22.04 LTS",
            "containerRuntimeVersion": "containerd://1.6.20",
            "kernelVersion": "5.15.0-88-generic"
          }
        },
        "spec": {
          "providerID": "aws:///us-east-1b/i-0123456789node2"
        }
      },
      {
        "metadata": {
          "name": "ip-10-0-2-200.ec2.internal",
          "labels": {
            "node-role.kubernetes.io/worker": "true"
          }
        },
        "status": {
          "nodeInfo": {
            "kubeletVersion": "v1.25.0",
            "osImage": "Ubuntu 22.04 LTS",
            "containerRuntimeVersion": "containerd://1.6.20",
            "kernelVersion": "5.15.0-88-generic"
          }
        },
        "spec": {
          "providerID": "aws:///us-east-1a/i-0123456789worker1"
        }
